<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <article class="article">
    <header class="article__hero">
      <div class="container narrow">
        <nav class="breadcrumb breadcrumb--light" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a><span aria-hidden="true">/</span></li>
            <li><a href="/blog">Blog</a><span aria-hidden="true">/</span></li>
            <li><span aria-current="page"><%= post.category %></span></li>
          </ol>
        </nav>
        <p class="eyebrow eyebrow--light"><%= post.category %></p>
        <h1><%= post.title %></h1>
        <p class="article__meta">
          <span><%- icon('users', 15) %> <%= post.author %>, <%= post.authorRole %></span>
          <span><%- icon('calendar', 15) %> <time datetime="<%= post.date %>"><%= fmtDate(post.date) %></time></span>
          <span><%- icon('clock', 15) %> <%= post.readingTime %></span>
        </p>
      </div>
    </header>

    <div class="container article__layout">
      <div class="article__main">
        <img class="article__image" src="<%= post.image %>" alt="<%= post.title %>" width="1536" height="1024" loading="eager" decoding="async">
        <div class="prose">
          <%- post.body %>
        </div>

        <div class="article__share">
          <span>Share this article:</span>
          <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + '/blog/' + post.slug) %>" target="_blank" rel="noopener" aria-label="Share on Facebook"><%- icon('facebook', 16) %></a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(baseUrl + '/blog/' + post.slug) %>" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><%- icon('linkedin', 16) %></a>
          <a href="https://x.com/intent/tweet?url=<%= encodeURIComponent(baseUrl + '/blog/' + post.slug) %>&text=<%= encodeURIComponent(post.title) %>" target="_blank" rel="noopener" aria-label="Share on X"><%- icon('x', 16) %></a>
        </div>
      </div>

      <aside class="article__aside">
        <div class="aside-card aside-card--author">
          <span class="aside-card__label">Written by</span>
          <h3><%= post.author %></h3>
          <p class="aside-card__role"><%= post.authorRole %></p>
          <p>Part of the Roofex team, helping homeowners and property managers make confident roofing decisions.</p>
        </div>

        <div class="aside-card aside-card--cta">
          <h3>Need roofing help?</h3>
          <p>Get a free, no-obligation inspection and a fixed written quote.</p>
          <a class="btn btn--primary btn--block" href="/contact">Get a Free Quote</a>
          <a class="btn btn--outline btn--block" href="tel:<%= site.phoneHref %>"><%- icon('phone', 16) %> <%= site.phone %></a>
        </div>

        <% if (related.length) { %>
        <div class="aside-card">
          <span class="aside-card__label">Related reading</span>
          <ul class="aside-list">
            <% related.forEach(function (r) { %>
            <li>
              <a href="/blog/<%= r.slug %>">
                <img src="<%= r.image %>" alt="" width="120" height="90" loading="lazy" decoding="async">
                <span><%= r.title %></span>
              </a>
            </li>
            <% }); %>
          </ul>
        </div>
        <% } %>
      </aside>
    </div>
  </article>

  <%- include('partials/cta') %>
</main>

<%- include('partials/footer') %>
