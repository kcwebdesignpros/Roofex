<section class="cta-band">
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      <p class="eyebrow eyebrow--light">Ready when you are</p>
      <h2>Get your free, no-obligation roofing estimate</h2>
      <p>Talk to a certified Roofex advisor today. We inspect, document and quote — with fixed pricing and zero pressure.</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--primary btn--lg" href="/contact">Get a Free Quote</a>
      <a class="btn btn--ghost btn--lg" href="tel:<%= site.phoneHref %>"><%- icon('phone', 18) %> <%= site.phone %></a>
    </div>
  </div>
</section>
