<section class="page-hero<%= typeof heroImage !== 'undefined' && heroImage ? ' page-hero--img' : '' %>"<% if (typeof heroImage !== 'undefined' && heroImage) { %> style="--hero-img:url('<%= heroImage %>')"<% } %>>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <% crumbs.forEach(function (c, i) { %>
        <li>
          <% if (i < crumbs.length - 1) { %><a href="<%= c.url %>"><%= c.name %></a><span aria-hidden="true">/</span>
          <% } else { %><span aria-current="page"><%= c.name %></span><% } %>
        </li>
        <% }); %>
      </ol>
    </nav>
    <h1 class="page-hero__title"><%= heroTitle %></h1>
    <% if (typeof heroText !== 'undefined' && heroText) { %><p class="page-hero__text"><%= heroText %></p><% } %>
  </div>
</section>
