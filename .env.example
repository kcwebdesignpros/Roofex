# ---------------------------------------------------------------
# Roofex — environment variables
# Copy this file to `.env` and adjust the values for your server.
# On Vercel / Hostinger, set these in the dashboard instead.
# ---------------------------------------------------------------

# Port the Node server listens on (Hostinger/VPS: 3000 is fine behind Nginx).
# On Vercel you do NOT need to set this — the platform provides it.
PORT=3000

# The public URL of the site. Used for canonical tags, Open Graph URLs,
# JSON-LD @id values and the absolute sitemap URL in robots.txt.
# Local:  http://localhost:3000
# Live:   https://www.roofex.com   (no trailing slash)
SITE_URL=http://localhost:3000
